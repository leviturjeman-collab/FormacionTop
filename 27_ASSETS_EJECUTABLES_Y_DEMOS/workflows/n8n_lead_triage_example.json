      ]
    },
    {
      "parameters": {
        "jsCode": "// Un webhook entrega { headers, params, query, body }: el lead va en body.\n// Antes se leia la raiz, asi que los cinco campos salian siempre ausentes.\nconst item = $input.first().json.body ?? $input.first().json;\n\nconst REQUERIDOS = ['lead_id', 'name', 'email', 'message', 'source'];\n\n// Falta un campo si no viene, si viene nulo o si viene en blanco.\nconst missing = REQUERIDOS.filter((campo) => {\n  const valor = item[campo];\n  return valor === undefined || valor === null || String(valor).trim() === '';\n});\n\nreturn [{ json: { ...item, missing_fields: missing, needs_human_review: missing.length > 0 } }];"
      },
      "id": "validate-lead",
      "name": "Validate Lead",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { lead_id: $json.lead_id, needs_human_review: $json.needs_human_review, missing_fields: $json.missing_fields } }}"
      },
      "id": "respond",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        800,
