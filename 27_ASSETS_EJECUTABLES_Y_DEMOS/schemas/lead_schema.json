{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lead intake schema",
  "type": "object",
  "required": ["lead_id", "name", "email", "message", "source"],
  "properties": {
    "lead_id": { "type": "string" },
    "name": { "type": "string" },
    "email": { "type": "string", "format": "email" },
    "company": { "type": ["string", "null"] },
    "message": { "type": "string" },
    "budget_range": { "type": ["string", "null"] },
    "urgency": { "type": ["string", "null"], "enum": ["low", "medium", "high", null] },
    "source": { "type": "string" }
  }
}
