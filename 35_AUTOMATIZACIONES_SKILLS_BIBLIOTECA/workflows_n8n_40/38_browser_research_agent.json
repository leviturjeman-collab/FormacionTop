{
  "name": "38 · Agente de investigación web",
  "nodes": [
    {
      "parameters": {
        "content": "## 38 · Investigador web\n\nUsa la búsqueda web integrada de la API de Anthropic (herramienta web_search, máx. 3 búsquedas por encargo): no necesitas otro buscador.\n\nEl informe se guarda en Sheets y se deja como BORRADOR en Gmail para que lo revises antes de reenviarlo a nadie. La búsqueda web tiene coste adicional por uso: COMPROBAR EN LA WEB OFICIAL.",
        "width": 500,
        "height": 260
      },
      "id": "nodo_185",
      "name": "Nota de configuración",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -40,
        40
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "wf-38-investigar",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "nodo_186",
      "name": "Encargo de investigación",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        340
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const b = $json.body || {};\nconst faltan = [];\nif (b.tema === undefined || b.tema === null || String(b.tema).trim() === '') {\n  faltan.push('tema');\n}\nconst salida = {\n  tema: String(b.tema || '').trim().slice(0, 500),\n  solicitante: String(b.solicitante || 'anónimo').trim(),\n  faltan: faltan,\n  valido: faltan.length === 0\n};\nreturn { json: salida };"
      },
      "id": "nodo_187",
      "name": "Validar encargo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        340
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "cond_024",
              "leftValue": "={{ $json.valido }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "nodo_188",
      "name": "¿Encargo completo?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        440,
        340
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const sistema = [\n  'Eres un investigador riguroso. Escribes en español.',\n  'Usa la herramienta de búsqueda web para documentarte antes de responder.',\n  'Estructura: contexto, hallazgos clave (con la fuente entre paréntesis), y una conclusión prudente.',\n  'Si las fuentes se contradicen, dilo. No inventes datos ni URLs.'\n].join('\\n');\nconst peticion_ia = {\n  model: 'claude-opus-5',\n  max_tokens: 4096,\n  system: sistema,\n  tools: [\n    { type: 'web_search_20260209', name: 'web_search', max_uses: 3 }\n  ],\n  messages: [\n    { role: 'user', content: 'Investiga y redacta un informe breve sobre: ' + $json.tema }\n  ]\n};\nreturn { json: { peticion_ia: peticion_ia } };"
      },
      "id": "nodo_189",
      "name": "Preparar investigación",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        240
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.peticion_ia) }}",
        "options": {}
      },
      "id": "nodo_190",
      "name": "Investigar con Claude",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        240
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REEMPLAZAR",
          "name": "Anthropic API (x-api-key)"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const bloques = $json.content || [];\nconst informe = bloques\n  .filter(function (b) { return b.type === 'text'; })\n  .map(function (b) { return b.text; })\n  .join('\\n')\n  .trim();\nconst fuentes = [];\nfor (const bloque of bloques) {\n  if (bloque.type === 'web_search_tool_result' && Array.isArray(bloque.content)) {\n    for (const r of bloque.content) {\n      if (r && r.url && fuentes.indexOf(r.url) === -1) {\n        fuentes.push(r.url);\n      }\n    }\n  }\n}\nconst origen = $('Validar encargo').item.json;\nconst salida = {\n  tema: origen.tema,\n  solicitante: origen.solicitante,\n  informe: informe,\n  fuentes: fuentes.join('\\n'),\n  total_fuentes: fuentes.length,\n  generado_en: new Date().toISOString()\n};\nreturn { json: salida };"
      },
      "id": "nodo_191",
      "name": "Extraer informe",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        240
      ]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "REEMPLAZAR_ID_DOCUMENTO"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Investigaciones"
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "matchingColumns": [],
          "schema": []
        },
        "options": {}
      },
      "id": "nodo_192",
      "name": "Registrar informe",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        1320,
        240
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REEMPLAZAR",
          "name": "Google Sheets (OAuth2)"
        }
      }
    },
    {
      "parameters": {
        "resource": "draft",
        "operation": "create",
        "subject": "=[Borrador] Informe: {{ $json.tema }}",
        "emailType": "text",
        "message": "=Informe generado automáticamente para {{ $json.solicitante }}. Revísalo y contrasta las fuentes antes de compartirlo.\n\n{{ $json.informe }}\n\nFUENTES ({{ $json.total_fuentes }}):\n{{ $json.fuentes }}",
        "options": {
          "sendTo": "REEMPLAZAR_tu_correo@ejemplo.com"
        }
      },
      "id": "nodo_193",
      "name": "Borrador del informe",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        1540,
        240
      ],
      "credentials": {
        "gmailOAuth2": {
          "id": "REEMPLAZAR",
          "name": "Gmail (OAuth2)"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { ok: true, tema: $('Extraer informe').first().json.tema, informe: $('Extraer informe').first().json.informe, fuentes: $('Extraer informe').first().json.total_fuentes } }}",
        "options": {}
      },
      "id": "nodo_194",
      "name": "Responder informe",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1760,
        240
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { ok: false, error: 'faltan_campos', faltan: $json.faltan } }}",
        "options": {
          "responseCode": 400
        }
      },
      "id": "nodo_195",
      "name": "Responder incompleto",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        660,
        460
      ]
    }
  ],
