    {
      "parameters": {
        "jsCode": "// Calcula cuantas horas lleva abierto cada ticket y su limite de SLA.\nconst SLA_HORAS = { alta: 4, media: 8, baja: 24 };\nconst ahora = Date.now();\nconst filas = $input.all().map((i) => i.json);\nconst incumplidos = [];\nfor (const t of filas) {\n  const creado = Date.parse(t.creado_en);\n  if (!Number.isFinite(creado)) continue; // fila sin fecha valida: la ignoramos\n  const horas = (ahora - creado) / 36e5;\n  const limite = SLA_HORAS[String(t.prioridad ?? '').toLowerCase()] ?? 24;\n  if (horas > limite) {\n    incumplidos.push({\n      ticket_id: t.ticket_id,\n      asunto: t.asunto,\n      prioridad: t.prioridad,\n      horas_abierto: Math.round(horas * 10) / 10,\n      limite_horas: limite,\n    });\n  }\n}\nconst lineas = incumplidos\n  .map((t) => '- ' + t.ticket_id + ' (' + t.prioridad + '): ' + t.horas_abierto + ' h abiertas, limite ' + t.limite_horas + ' h. ' + t.asunto)\n  .join('\\n');\nreturn [{ json: {\n  hay_incumplidos: incumplidos.length > 0,\n  total: incumplidos.length,\n  incumplidos,\n  mensaje: 'ALERTA SLA: ' + incumplidos.length + ' ticket(s) fuera de plazo\\n' + lineas + '\\nRevisa el panel de soporte y reasigna. Este aviso no responde al cliente.',\n  evaluado_en: new Date().toISOString(),\n} }];"
      },
