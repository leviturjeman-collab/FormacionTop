{
  "name": "05 · Categorizador de gastos con IA",
  "nodes": [
    {
      "parameters": {
        "content": "## 05 · Categorizador de gastos\n\n1. Credenciales: Anthropic API, Google Sheets (OAuth2) y Slack Bot.\n2. Pestaña \"Gastos\" con columnas: id, fecha, concepto, importe, categoria (vacía si está pendiente).\n3. Pestaña \"Gastos categorizados\" donde se registra el resultado.\n4. Corre cada día a las 07:00; cámbialo en el disparador.",
        "width": 420,
        "height": 240
      },
      "id": "nodo-001",
      "name": "Nota · Configuración",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        40,
        20
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "triggerAtHour": 7
            }
          ]
        }
      },
      "id": "nodo-002",
      "name": "Cada día a las 7",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        40,
        400
      ]
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "REEMPLAZAR_ID_DOCUMENTO"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Gastos"
        },
        "options": {}
      },
      "id": "nodo-003",
      "name": "Leer gastos",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        260,
        400
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REEMPLAZAR",
          "name": "Google Sheets (OAuth2)"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Reune en un solo item los gastos que aun no tienen categoria.\nconst filas = $input.all().map((i) => i.json);\nconst pendientes = filas.filter((f) => !String(f.categoria ?? '').trim() && String(f.concepto ?? '').trim());\nreturn [{ json: {\n  hay_pendientes: pendientes.length > 0,\n  total_pendientes: pendientes.length,\n  pendientes,\n  procesado_en: new Date().toISOString(),\n} }];"
      },
      "id": "nodo-004",
      "name": "Agrupar pendientes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        400
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "cond-1",
              "leftValue": "={{ $json.hay_pendientes }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "nodo-005",
      "name": "¿Hay pendientes?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        700,
        400
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'claude-opus-5', max_tokens: 2048, system: \"Eres un asistente contable. Categoriza gastos de una pyme espanola en una de estas categorias: software, marketing, viajes, dietas, oficina, formacion, asesoria, otros. Responde SOLO con un array JSON de objetos { id, categoria, confianza } sin texto adicional.\", messages: [{ role: 'user', content: 'Categoriza estos gastos: ' + JSON.stringify($json.pendientes) }] }) }}",
        "options": {}
      },
      "id": "nodo-006",
      "name": "Categorizar con IA",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        920,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REEMPLAZAR",
          "name": "Anthropic API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Cruza la respuesta de la IA con los gastos originales.\nconst bloque = ($json.content || []).find((b) => b.type === 'text');\nconst texto = bloque ? bloque.text : '';\nlet lista = [];\ntry {\n  lista = JSON.parse(texto.replace(/^\\s*```(?:json)?/i, '').replace(/```\\s*$/, '').trim());\n} catch (e) {\n  lista = [];\n}\nif (!Array.isArray(lista)) lista = [];\nlista = lista.filter(g => g && typeof g === 'object' && typeof g.categoria === 'string');\nconst previo = $('Agrupar pendientes').item.json;\nconst porId = new Map(lista.map((g) => [String(g.id), g]));\nreturn previo.pendientes.map((gasto) => {\n  const ia = porId.get(String(gasto.id)) || { categoria: 'revisar', confianza: 0 };\n  return { json: { ...gasto, categoria: ia.categoria, confianza: ia.confianza, procesado_en: previo.procesado_en } };\n});"
      },
      "id": "nodo-007",
      "name": "Interpretar categorías",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1140,
        300
      ]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "REEMPLAZAR_ID_DOCUMENTO"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Gastos categorizados"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "fecha_proceso": "={{ $json.procesado_en }}",
            "id": "={{ $json.id }}",
            "fecha": "={{ $json.fecha }}",
            "concepto": "={{ $json.concepto }}",
            "importe": "={{ $json.importe }}",
            "categoria": "={{ $json.categoria }}",
            "confianza": "={{ $json.confianza }}"
          },
          "matchingColumns": [],
          "schema": []
        },
        "options": {}
      },
      "id": "nodo-008",
      "name": "Registrar categorizados",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        1360,
        300
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REEMPLAZAR",
          "name": "Google Sheets (OAuth2)"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Junta el resultado en un unico mensaje para Slack.\nconst filas = $input.all().map((i) => i.json);\nconst dudosos = filas.filter((f) => f.categoria === 'revisar' || Number(f.confianza ?? 0) < 0.7).length;\nreturn [{ json: {\n  mensaje: 'Gastos categorizados hoy: ' + filas.length + ' (' + dudosos + ' para revisar). Comprueba la pestaña \"Gastos categorizados\" antes de darlos por buenos: la IA solo propone, no decide.',\n} }];"
      },
      "id": "nodo-009",
      "name": "Componer aviso",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1580,
        300
      ]
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "id",
          "value": "REEMPLAZAR_ID_CANAL"
        },
        "text": "={{ $json.mensaje }}",
        "otherOptions": {}
      },
      "id": "nodo-010",
      "name": "Resumen a finanzas",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [
        1800,
        300
      ],
      "credentials": {
        "slackApi": {
          "id": "REEMPLAZAR",
          "name": "Slack Bot"
        }
      }
    },
    {
      "parameters": {},
      "id": "nodo-011",
      "name": "Nada pendiente",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        920,
        520
      ]
    }
  ],
