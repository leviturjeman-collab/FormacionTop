{
  "name": "13 · Contenido convertido en posts de LinkedIn",
  "nodes": [
    {
      "parameters": {
        "content": "## 13 · Contenido → posts LinkedIn\n\n1. Credenciales: Anthropic API, Google Sheets y Gmail.\n2. Pestañas: \"Posts LinkedIn\" y \"Contenido incompleto\".\n3. Los 3 posts quedan en la hoja y en un BORRADOR de Gmail para que los apruebes: este flujo NO publica en LinkedIn.\n4. Envía en el body: titulo, contenido y (opcional) enlace.",
        "width": 420,
        "height": 240
      },
      "id": "nodo-001",
      "name": "Nota · Configuración",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        40,
        20
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "wf-13-contenido-fuente",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "nodo-002",
      "name": "Webhook contenido",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        40,
        400
      ]
    },
    {
      "parameters": {
        "jsCode": "// El contenido fuente llega dentro de body.\nconst b = $json.body ?? {};\nreturn [{ json: {\n  titulo: String(b.titulo ?? '').trim(),\n  contenido: String(b.contenido ?? '').trim().slice(0, 12000),\n  enlace: String(b.enlace ?? '').trim(),\n  recibido_en: new Date().toISOString(),\n} }];"
      },
      "id": "nodo-003",
      "name": "Normalizar contenido",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        400
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}"
      },
      "id": "nodo-004",
      "name": "Responder recepción",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        480,
        400
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "cond-1",
              "leftValue": "={{ $json.contenido }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "nodo-005",
      "name": "¿Trae contenido?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        700,
        400
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'claude-opus-5', max_tokens: 2048, system: \"Eres estratega de contenido B2B en LinkedIn, escribes en espanol con gancho pero sin humo. Responde SOLO con un array JSON de exactamente 3 objetos { gancho, cuerpo, hashtags } (hashtags: lista de 3-5 strings sin #).\", messages: [{ role: 'user', content: 'Convierte este contenido en 3 posts de LinkedIn distintos (angulo practico, angulo de datos y angulo de historia). Titulo: ' + $json.titulo + '. Enlace: ' + $json.enlace + '.\\nContenido:\\n' + $json.contenido }] }) }}",
        "options": {}
      },
      "id": "nodo-006",
      "name": "Generar 3 posts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        920,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REEMPLAZAR",
          "name": "Anthropic API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Un item por post generado.\nconst bloque = ($json.content || []).find((b) => b.type === 'text');\nconst texto = bloque ? bloque.text : '';\nlet posts = [];\ntry {\n  posts = JSON.parse(texto.replace(/^\\s*```(?:json)?/i, '').replace(/```\\s*$/, '').trim());\n} catch (e) {\n  posts = [{ gancho: 'REVISAR: la IA no devolvio JSON', cuerpo: texto.slice(0, 1000), hashtags: [] }];\n}\nconst fuente = $('Normalizar contenido').item.json;\nreturn posts.map((p, i) => ({ json: {\n  fecha: fuente.recibido_en,\n  titulo_fuente: fuente.titulo,\n  numero: i + 1,\n  gancho: String(p.gancho ?? ''),\n  cuerpo: String(p.cuerpo ?? ''),\n  hashtags: (p.hashtags || []).map((h) => '#' + h).join(' '),\n} }));"
      },
      "id": "nodo-007",
      "name": "Trocear posts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1140,
        300
      ]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "REEMPLAZAR_ID_DOCUMENTO"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Posts LinkedIn"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "fecha": "={{ $json.fecha }}",
            "titulo_fuente": "={{ $json.titulo_fuente }}",
            "numero": "={{ $json.numero }}",
            "gancho": "={{ $json.gancho }}",
            "cuerpo": "={{ $json.cuerpo }}",
            "hashtags": "={{ $json.hashtags }}",
            "estado": "pendiente de aprobacion"
          },
          "matchingColumns": [],
          "schema": []
        },
        "options": {}
      },
      "id": "nodo-008",
      "name": "Registrar posts",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        1360,
        300
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REEMPLAZAR",
          "name": "Google Sheets (OAuth2)"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Junta los 3 posts en un solo borrador de revision.\nconst posts = $input.all().map((i) => i.json);\nconst cuerpo = posts\n  .map((p) => 'POST ' + p.numero + '\\n' + p.gancho + '\\n\\n' + p.cuerpo + '\\n' + p.hashtags)\n  .join('\\n\\n----------------\\n\\n');\nreturn [{ json: {\n  titulo: posts[0] ? posts[0].titulo_fuente : 'contenido',\n  cuerpo: cuerpo + '\\n\\nRevisa, elige y publica a mano en LinkedIn. Nada se publica automaticamente.',\n} }];"
      },
      "id": "nodo-009",
      "name": "Componer email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1580,
        300
      ]
    },
    {
      "parameters": {
        "resource": "draft",
        "subject": "={{ 'Posts LinkedIn para aprobar: ' + $json.titulo }}",
        "emailType": "text",
        "message": "={{ $json.cuerpo }}",
        "options": {
          "sendTo": "REEMPLAZAR@tuempresa.com"
        }
      },
      "id": "nodo-010",
      "name": "Borrador para aprobar",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        1800,
        300
      ],
      "credentials": {
        "gmailOAuth2": {
          "id": "REEMPLAZAR",
          "name": "Gmail (OAuth2)"
        }
      }
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "REEMPLAZAR_ID_DOCUMENTO"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Contenido incompleto"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "fecha": "={{ $json.recibido_en }}",
            "titulo": "={{ $json.titulo }}",
            "motivo": "la peticion no traia el campo contenido"
          },
          "matchingColumns": [],
          "schema": []
        },
        "options": {}
      },
      "id": "nodo-011",
      "name": "Registrar incompleto",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        920,
        520
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REEMPLAZAR",
          "name": "Google Sheets (OAuth2)"
        }
      }
    }
  ],
