{
  "name": "30 · Monitor de fugas de secretos",
  "nodes": [
    {
      "parameters": {
        "content": "## 30 · Fugas de secretos\n\n1. Webhook de GitHub en el repo (evento Push).\n2. Credencial Header Auth \"GitHub (Authorization: Bearer)\" para descargar el diff del commit.\n3. Bot de Telegram (@BotFather, gratis) y tu chat_id en el nodo de alerta.\n\nSi hay hallazgo: revoca la clave YA. Borrar el commit no basta.",
        "width": 460,
        "height": 260
      },
      "id": "nodo_100",
      "name": "Nota de configuración",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -40,
        40
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "wf-30-push-codigo",
        "options": {}
      },
      "id": "nodo_101",
      "name": "Push de GitHub",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        340
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const b = $json.body || {};\nconst repo = b.repository || {};\nconst salida = {\n  repo_completo: String(repo.full_name || ''),\n  sha: String(b.after || ''),\n  rama: String(b.ref || ''),\n  autor: b.pusher && b.pusher.name ? b.pusher.name : 'desconocido',\n  total_commits: (b.commits || []).length,\n  valido: Boolean(repo.full_name && b.after && b.after !== '0000000000000000000000000000000000000000')\n};\nreturn { json: salida };"
      },
      "id": "nodo_102",
      "name": "Validar push",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        340
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "cond_012",
              "leftValue": "={{ $json.valido }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "nodo_103",
      "name": "¿Push válido?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        440,
        340
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ 'https://api.github.com/repos/' + $json.repo_completo + '/commits/' + $json.sha }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "text",
              "outputPropertyName": "diff"
            }
          }
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github.diff"
            },
            {
              "name": "User-Agent",
              "value": "n8n-workflow-30"
            }
          ]
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "id": "nodo_104",
      "name": "Descargar diff del push",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        240
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REEMPLAZAR",
          "name": "GitHub (Authorization: Bearer)"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const diff = String($json.diff || '');\nconst patrones = [\n  { nombre: 'Clave de Anthropic', re: /sk-ant-[A-Za-z0-9_-]{20,}/g },\n  { nombre: 'Clave estilo OpenAI', re: /sk-[A-Za-z0-9]{20,}/g },\n  { nombre: 'Token de GitHub', re: /gh[pousr]_[A-Za-z0-9]{20,}/g },\n  { nombre: 'Clave de acceso AWS', re: /AKIA[0-9A-Z]{16}/g },\n  { nombre: 'Token de Slack', re: /xox[abprs]-[A-Za-z0-9-]{10,}/g },\n  { nombre: 'Clave privada PEM', re: /-----BEGIN [A-Z ]*PRIVATE KEY-----/g },\n  { nombre: 'Cadena de conexión con contraseña', re: /postgres(?:ql)?:\\/\\/[^\\s:]+:[^\\s@]+@/g }\n];\nconst hallazgos = [];\nfor (const p of patrones) {\n  const coincidencias = diff.match(p.re) || [];\n  for (const c of coincidencias) {\n    // Nunca guardamos el secreto completo: solo un prefijo enmascarado.\n    hallazgos.push(p.nombre + ' → ' + c.slice(0, 8) + '…');\n  }\n}\nconst origen = $('Validar push').item.json;\nconst salida = {\n  repo_completo: origen.repo_completo,\n  sha: origen.sha.slice(0, 10),\n  rama: origen.rama,\n  autor: origen.autor,\n  total_hallazgos: hallazgos.length,\n  hallazgos: hallazgos.join(' | '),\n  hay_hallazgos: hallazgos.length > 0,\n  escaneado_en: new Date().toISOString()\n};\nreturn { json: salida };"
      },
      "id": "nodo_105",
      "name": "Escanear secretos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        240
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "cond_013",
              "leftValue": "={{ $json.hay_hallazgos }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "nodo_106",
      "name": "¿Hay hallazgos?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1100,
        240
      ]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "REEMPLAZAR_ID_DOCUMENTO"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Hallazgos"
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "matchingColumns": [],
          "schema": []
        },
        "options": {}
      },
      "id": "nodo_107",
      "name": "Registrar hallazgo",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        1320,
        140
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REEMPLAZAR",
          "name": "Google Sheets (OAuth2)"
        }
      }
    },
    {
      "parameters": {
        "chatId": "REEMPLAZAR_CHAT_ID",
        "text": "=[ALERTA] Posible secreto filtrado\n\nRepo: {{ $json.repo_completo }}\nRama: {{ $json.rama }}\nCommit: {{ $json.sha }}\nAutor: {{ $json.autor }}\nHallazgos ({{ $json.total_hallazgos }}): {{ $json.hallazgos }}\n\nAcción inmediata: revoca la clave y reescribe el historial si procede.",
        "additionalFields": {}
      },
      "id": "nodo_108",
      "name": "Alerta por Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1540,
        140
      ],
      "credentials": {
        "telegramApi": {
          "id": "REEMPLAZAR",
          "name": "Telegram Bot"
        }
      }
    },
    {
      "parameters": {},
      "id": "nodo_109",
      "name": "Sin hallazgos",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1320,
        360
      ]
    },
    {
      "parameters": {},
      "id": "nodo_110",
      "name": "Push ignorado",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        660,
        460
      ]
    }
  ],
