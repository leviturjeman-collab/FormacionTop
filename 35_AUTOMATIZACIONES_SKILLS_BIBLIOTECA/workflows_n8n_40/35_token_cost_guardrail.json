          "conditions": [
            {
              "id": "budget-mode",
              "leftValue": "={{ ['reserve','settle'].includes($json.body.mode) }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "8066a7b5-a749-4827-a4af-bb96a00d4606",
      "name": "Presupuesto transaccional previo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        300,
        800
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ 'http://127.0.0.1:8081/budget/' + $json.body.mode }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body.mode === 'reserve' ? {id:$json.body.request_id,app:$json.body.app,ceiling_micro_usd:$json.body.ceiling_micro_usd} : {id:$json.body.request_id,actual_micro_usd:$json.body.actual_micro_usd}) }}",
        "options": {
          "timeout": 10000,
          "response": {
            "response": {
              "neverError": true,
              "fullResponse": true
            }
          }
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "REEMPLAZAR_OPERATIONS",
          "name": "Operations store: X-Operations-Token"
        }
      }
    },
    {
      "id": "34ec99ff-4795-4e39-8507-8c6ae501eef3",
      "name": "Responder decisión de presupuesto",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        300,
        800
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json.body }}",
        "options": {
          "responseCode": "={{ $json.statusCode || 503 }}"
        }
      }
    }
  ],
