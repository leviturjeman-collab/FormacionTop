{
  "name": "23 · Refresco programado de vectores",
  "nodes": [
    {
      "parameters": {
        "content": "## 23 · Refresco de vectores\n\nCada día a las 03:00 busca trozos con embedding_estado = pendiente, pide el embedding a OpenAI y actualiza la fila.\n\nRequiere: tabla documentos_rag del flujo 21 (con columna embedding, tipo vector si usas pgvector), credencial Header Auth de OpenAI (Authorization: Bearer TU_CLAVE), Postgres y Google Sheets.",
        "width": 460,
        "height": 260
      },
      "id": "nodo_022",
      "name": "Nota de configuración",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -40,
        40
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      },
      "id": "nodo_023",
      "name": "Cada día a las 03:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        340
      ],
      "notes": "Processes 25 chunks per run every 5 minutes. Monitor pending count; scale workers if ingestion exceeds processing throughput."
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, titulo, trozo, count(*) OVER() AS total_pending FROM documentos_rag WHERE embedding_estado = 'pendiente' ORDER BY id LIMIT 25;",
        "options": {}
      },
      "id": "nodo_024",
      "name": "Buscar trozos pendientes",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        220,
        340
      ],
      "credentials": {
        "postgres": {
          "id": "REEMPLAZAR",
          "name": "Postgres (Supabase)"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const filas = $input.all().filter(function (item) {\n  return item.json && item.json.id !== undefined && item.json.id !== null;\n});\nif (filas.length === 0) {\n  return [ { json: { hay_pendientes: false, total_pendientes: 0 } } ];\n}\nreturn filas.map(function (item) {\n  const j = item.json;\n  return {\n    json: {\n      hay_pendientes: true,\n      total_pending: Number(j.total_pending || 0),\n      id: j.id,\n      titulo: j.titulo || '',\n      contenido: String(j.trozo || '').slice(0, 8000)\n    }\n  };\n});"
      },
      "id": "nodo_025",
      "name": "Preparar pendientes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        340
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "cond_003",
              "leftValue": "={{ $json.hay_pendientes }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "nodo_026",
      "name": "¿Hay pendientes?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        660,
        340
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/embeddings",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'text-embedding-3-small', input: $json.contenido }) }}",
        "options": {}
      },
      "id": "nodo_027",
      "name": "Pedir embedding a OpenAI",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        240
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REEMPLAZAR",
          "name": "OpenAI API (Authorization: Bearer)"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE documentos_rag SET embedding=$1,embedding_estado='actualizado',embedding_model='text-embedding-3-small',embedding_dimensions=1536,embedded_at=NOW() WHERE id=$2;",
        "options": {
          "queryReplacement": "={{ [JSON.stringify($json.data[0].embedding), $(\"Preparar pendientes\").item.json.id] }}"
        }
      },
      "id": "nodo_028",
      "name": "Actualizar vector",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1100,
        240
      ],
      "credentials": {
        "postgres": {
          "id": "REEMPLAZAR",
          "name": "Postgres (Supabase)"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const actualizados = $('Preparar pendientes').all();\nconst salida = {\n  documentos_actualizados: actualizados.length,\n  pending_after_batch: Math.max(0, Number(actualizados[0]?.json.total_pending || 0) - actualizados.length),\n  ids: actualizados.map(function (i) { return i.json.id; }).join(', '),\n  estado: 'vectores_refrescados',\n  fecha: new Date().toISOString()\n};\nreturn [ { json: salida } ];"
      },
      "id": "nodo_029",
      "name": "Resumir refresco",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        240
      ]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "REEMPLAZAR_ID_DOCUMENTO"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Refrescos"
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "matchingColumns": [],
          "schema": []
        },
        "options": {}
      },
      "id": "nodo_030",
      "name": "Registrar refresco",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        1540,
        240
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REEMPLAZAR",
          "name": "Google Sheets (OAuth2)"
        }
      }
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "REEMPLAZAR_tu_correo@ejemplo.com",
        "subject": "=[n8n] Vectores refrescados: {{ $json.documentos_actualizados }}",
        "emailType": "text",
        "message": "=Refresco nocturno completado.\n\nDocumentos actualizados: {{ $json.documentos_actualizados }}\nIDs: {{ $json.ids }}\nFecha: {{ $json.fecha }}",
        "options": {}
      },
      "id": "nodo_031",
      "name": "Avisar por Gmail",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        1760,
        240
      ],
      "credentials": {
        "gmailOAuth2": {
          "id": "REEMPLAZAR",
          "name": "Gmail (OAuth2)"
        }
      }
    },
    {
      "parameters": {},
      "id": "nodo_032",
      "name": "Nada pendiente",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        880,
        460
      ]
    }
  ],
