{
  "name": "08 · Sentimiento de feedback de clientes",
  "nodes": [
    {
      "parameters": {
        "content": "## 08 · Sentimiento de feedback\n\n1. Credenciales: Anthropic API, Google Sheets y Slack Bot.\n2. Pestañas: \"Feedback\" y \"Feedback incompleto\".\n3. REEMPLAZAR_ID_CANAL: canal de Slack del equipo de experiencia de cliente.\n4. La respuesta sugerida por la IA queda en la hoja: NUNCA se envía sola al cliente.",
        "width": 420,
        "height": 240
      },
      "id": "nodo-001",
      "name": "Nota · Configuración",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        40,
        20
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "wf-08-feedback-cliente",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "nodo-002",
      "name": "Webhook feedback",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        40,
        400
      ]
    },
    {
      "parameters": {
        "jsCode": "// El feedback llega dentro de body.\nconst b = $json.body ?? {};\nreturn [{ json: {\n  cliente: String(b.cliente ?? 'anonimo').trim(),\n  email: String(b.email ?? '').trim().toLowerCase(),\n  canal: String(b.canal ?? 'web').trim(),\n  mensaje: String(b.mensaje ?? '').trim().slice(0, 4000),\n  recibido_en: new Date().toISOString(),\n} }];"
      },
      "id": "nodo-003",
      "name": "Normalizar feedback",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        400
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}"
      },
      "id": "nodo-004",
      "name": "Responder recepción",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        480,
        400
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "cond-1",
              "leftValue": "={{ $json.mensaje }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "nodo-005",
      "name": "¿Trae mensaje?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        700,
        400
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'claude-opus-5', max_tokens: 1024, system: \"Eres analista de experiencia de cliente. Responde SOLO con JSON valido con: sentimiento (positivo|neutro|negativo), urgencia (alta|media|baja), temas (lista de 1-3 strings) y respuesta_sugerida (2-3 frases en espanol; es solo una sugerencia interna).\", messages: [{ role: 'user', content: 'Analiza este feedback de cliente: ' + JSON.stringify($json) }] }) }}",
        "options": {}
      },
      "id": "nodo-006",
      "name": "Analizar sentimiento",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        920,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REEMPLAZAR",
          "name": "Anthropic API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// La API de Anthropic devuelve una lista de bloques; con el razonamiento\n// activado el primero puede ser de tipo \"thinking\", asi que buscamos el\n// primer bloque de texto en vez de leer content[0] a ciegas.\nconst bloque = ($json.content || []).find((b) => b.type === 'text');\nconst texto = bloque ? bloque.text : '';\nlet ia = {};\ntry {\n  // La IA a veces envuelve el JSON en un bloque de codigo; lo limpiamos.\n  ia = JSON.parse(texto.replace(/^\\s*```(?:json)?/i, '').replace(/```\\s*$/, '').trim());\n} catch (e) {\n  ia = { sentimiento: 'revisar', urgencia: 'media', temas: [], respuesta_sugerida: '' };\n}\nconst original = $('Normalizar feedback').item.json;\nreturn [{ json: { ...original, ...ia, ia_texto_bruto: texto.slice(0, 500) } }];"
      },
      "id": "nodo-007",
      "name": "Interpretar análisis",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1140,
        300
      ]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "REEMPLAZAR_ID_DOCUMENTO"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Feedback"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "fecha": "={{ $json.recibido_en }}",
            "cliente": "={{ $json.cliente }}",
            "canal": "={{ $json.canal }}",
            "mensaje": "={{ $json.mensaje }}",
            "sentimiento": "={{ $json.sentimiento }}",
            "urgencia": "={{ $json.urgencia }}",
            "temas": "={{ ($json.temas || []).join(\", \") }}",
            "respuesta_sugerida": "={{ $json.respuesta_sugerida }}"
          },
          "matchingColumns": [],
          "schema": []
        },
        "options": {}
      },
      "id": "nodo-008",
      "name": "Registrar feedback",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        1360,
        300
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REEMPLAZAR",
          "name": "Google Sheets (OAuth2)"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "cond-1",
              "leftValue": "={{ $json.sentimiento }}",
              "rightValue": "negativo",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "nodo-009",
      "name": "¿Negativo?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1580,
        300
      ]
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "id",
          "value": "REEMPLAZAR_ID_CANAL"
        },
        "text": "={{ 'Feedback NEGATIVO de ' + $json.cliente + ' (urgencia ' + $json.urgencia + '): \"' + $json.mensaje.slice(0, 200) + '\". Temas: ' + ($json.temas || []).join(', ') + '. Hay una respuesta sugerida en la hoja Feedback: revisala y responde tu al cliente.' }}",
        "otherOptions": {}
      },
      "id": "nodo-010",
      "name": "Alertar a CX",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [
        1800,
        220
      ],
      "credentials": {
        "slackApi": {
          "id": "REEMPLAZAR",
          "name": "Slack Bot"
        }
      }
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "REEMPLAZAR_ID_DOCUMENTO"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Feedback incompleto"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "fecha": "={{ $json.recibido_en }}",
            "motivo": "la peticion no traia el campo mensaje",
            "datos_recibidos": "={{ JSON.stringify($json) }}"
          },
          "matchingColumns": [],
          "schema": []
        },
        "options": {}
      },
      "id": "nodo-011",
      "name": "Registrar incompleto",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        920,
        520
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REEMPLAZAR",
          "name": "Google Sheets (OAuth2)"
        }
      }
    }
  ],
