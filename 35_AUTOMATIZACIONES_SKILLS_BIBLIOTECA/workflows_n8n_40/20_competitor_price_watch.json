        "chatId": "REEMPLAZAR_CHAT_ID",
        "text": "={{ 'CAMBIO DE PRECIO · ' + $json.competidor + ' · ' + $json.producto + '\\nAntes: ' + $json.precio_anterior + ' EUR → Ahora: ' + $json.precio_actual + ' EUR (' + ($json.variacion_pct > 0 ? '+' : '') + $json.variacion_pct + '%)\\n' + $json.url_producto + '\\n\\nDecide tu si ajustar precios: este flujo solo avisa.' }}",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "id": "nodo-008",
      "name": "Avisar cambio de precio",
