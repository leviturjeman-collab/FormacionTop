{
  "name": "09 · Notas de reunión convertidas en tareas",
  "nodes": [
    {
      "parameters": {
        "content": "## 09 · Notas de reunión → tareas\n\n1. Credenciales: Anthropic API, Google Sheets y Gmail.\n2. Pestañas: \"Tareas\" y \"Notas incompletas\".\n3. El resumen queda como BORRADOR en Gmail dirigido al equipo: revísalo y envíalo tú.\n4. Envía en el body: titulo, notas y (opcional) asistentes.",
        "width": 420,
        "height": 240
      },
      "id": "nodo-001",
      "name": "Nota · Configuración",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        40,
        20
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "wf-09-notas-reunion",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "nodo-002",
      "name": "Webhook notas",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        40,
        400
      ]
    },
    {
      "parameters": {
        "jsCode": "// Las notas llegan dentro de body.\nconst b = $json.body ?? {};\nreturn [{ json: {\n  titulo: String(b.titulo ?? 'Reunion sin titulo').trim(),\n  notas: String(b.notas ?? '').trim().slice(0, 15000),\n  asistentes: String(b.asistentes ?? '').trim(),\n  recibido_en: new Date().toISOString(),\n} }];"
      },
      "id": "nodo-003",
      "name": "Normalizar notas",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        400
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}"
      },
      "id": "nodo-004",
      "name": "Responder recepción",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        480,
        400
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "cond-1",
              "leftValue": "={{ $json.notas }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "nodo-005",
      "name": "¿Trae notas?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        700,
        400
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'claude-opus-5', max_tokens: 2048, system: \"Eres un asistente de gestion de proyectos. Responde SOLO con un array JSON de objetos { tarea, responsable, fecha_limite } (fecha_limite YYYY-MM-DD o null si no se dijo). No inventes responsables: usa \\\"sin asignar\\\" si no queda claro.\", messages: [{ role: 'user', content: 'Extrae las tareas acordadas en esta reunion titulada \"' + $json.titulo + '\" con asistentes: ' + $json.asistentes + '.\\nNotas:\\n' + $json.notas }] }) }}",
        "options": {}
      },
      "id": "nodo-006",
      "name": "Extraer tareas con IA",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        920,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REEMPLAZAR",
          "name": "Anthropic API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Convierte el array de la IA en un item por tarea.\nconst bloque = ($json.content || []).find((b) => b.type === 'text');\nconst texto = bloque ? bloque.text : '';\nlet tareas = [];\ntry {\n  tareas = JSON.parse(texto.replace(/^\\s*```(?:json)?/i, '').replace(/```\\s*$/, '').trim());\n} catch (e) {\n  tareas = [{ tarea: 'REVISAR: la IA no devolvio JSON valido', responsable: 'sin asignar', fecha_limite: null }];\n}\nif (!Array.isArray(tareas) || tareas.length === 0) {\n  tareas = [{ tarea: 'Sin tareas detectadas: revisar notas', responsable: 'sin asignar', fecha_limite: null }];\n}\nconst reunion = $('Normalizar notas').item.json;\nreturn tareas.map((t) => ({ json: {\n  reunion: reunion.titulo,\n  fecha_registro: reunion.recibido_en,\n  tarea: String(t.tarea ?? ''),\n  responsable: String(t.responsable ?? 'sin asignar'),\n  fecha_limite: t.fecha_limite ?? 'sin fecha',\n} }));"
      },
      "id": "nodo-007",
      "name": "Trocear en tareas",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1140,
        300
      ]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "REEMPLAZAR_ID_DOCUMENTO"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Tareas"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "fecha_registro": "={{ $json.fecha_registro }}",
            "reunion": "={{ $json.reunion }}",
            "tarea": "={{ $json.tarea }}",
            "responsable": "={{ $json.responsable }}",
            "fecha_limite": "={{ $json.fecha_limite }}",
            "estado": "pendiente"
          },
          "matchingColumns": [],
          "schema": []
        },
        "options": {}
      },
      "id": "nodo-008",
      "name": "Registrar tareas",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        1360,
        300
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REEMPLAZAR",
          "name": "Google Sheets (OAuth2)"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Junta todas las tareas en un solo texto para el borrador de email.\nconst tareas = $input.all().map((i) => i.json);\nconst lineas = tareas.map((t) => '- ' + t.tarea + ' → ' + t.responsable + ' (limite: ' + t.fecha_limite + ')').join('\\n');\nconst reunion = $('Normalizar notas').item.json;\nreturn [{ json: {\n  titulo: reunion.titulo,\n  cuerpo: 'Tareas acordadas en \"' + reunion.titulo + '\":\\n\\n' + lineas + '\\n\\nRegistradas en la pestaña Tareas. Revisa este borrador antes de enviarlo al equipo.',\n} }];"
      },
      "id": "nodo-009",
      "name": "Componer resumen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1580,
        300
      ]
    },
    {
      "parameters": {
        "resource": "draft",
        "subject": "={{ 'Tareas de la reunion: ' + $json.titulo }}",
        "emailType": "text",
        "message": "={{ $json.cuerpo }}",
        "options": {
          "sendTo": "REEMPLAZAR@tuempresa.com"
        }
      },
      "id": "nodo-010",
      "name": "Borrador de resumen",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        1800,
        300
      ],
      "credentials": {
        "gmailOAuth2": {
          "id": "REEMPLAZAR",
          "name": "Gmail (OAuth2)"
        }
      }
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "REEMPLAZAR_ID_DOCUMENTO"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Notas incompletas"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "fecha": "={{ $json.recibido_en }}",
            "titulo": "={{ $json.titulo }}",
            "motivo": "la peticion no traia el campo notas"
          },
          "matchingColumns": [],
          "schema": []
        },
        "options": {}
      },
      "id": "nodo-011",
      "name": "Registrar incompleta",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        920,
        520
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REEMPLAZAR",
          "name": "Google Sheets (OAuth2)"
        }
      }
    }
  ],
