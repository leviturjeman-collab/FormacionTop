    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "REEMPLAZAR_dpo@ejemplo.com",
        "subject": "=[RGPD] Alta bloqueada sin consentimiento: {{ $json.email }}",
        "emailType": "text",
        "message": "=Se ha recibido un alta sin consentimiento explícito y se ha bloqueado.\n\nEmail: {{ $json.email }}\nFinalidad declarada: {{ $json.finalidad }}\nOrigen: {{ $json.origen }}\nFecha: {{ $json.fecha_consentimiento }}\n\nNo se ha procesado ningún dato. Revisa el formulario de origen.",
        "options": {}
