    {
      "parameters": {
        "jsCode": "// Un carrito es elegible si tiene telefono, consentimiento explicito\n// y lleva mas de 1 hora abandonado (y menos de 48 h: despues ya no molestamos).\nconst ahora = Date.now();\nreturn $input.all().map((i) => {\n  const c = i.json;\n  const abandonado = Date.parse(c.abandonado_en);\n  const horas = Number.isFinite(abandonado) ? (ahora - abandonado) / 36e5 : -1;\n  const telefono = String(c.telefono ?? '').replace(/[^+0-9]/g, '');\n  const consentimiento = String(c.consentimiento ?? '').trim().toLowerCase() === 'si';\n  const elegible = Boolean(telefono) && consentimiento && horas >= 1 && horas <= 48;\n  let motivo_descarte = '';\n  if (!telefono) motivo_descarte = 'sin telefono';\n  else if (!consentimiento) motivo_descarte = 'sin consentimiento';\n  else if (horas < 1) motivo_descarte = 'todavia no ha pasado 1 hora';\n  else if (horas > 48) motivo_descarte = 'demasiado antiguo (>48h)';\n  return { json: { ...c, telefono, horas_abandonado: Math.round(horas * 10) / 10, elegible, motivo_descarte } };\n});"
      },
      "id": "nodo-005",
      "name": "Evaluar elegibilidad",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        400
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
