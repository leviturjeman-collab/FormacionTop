        "message": "={{ 'Carrito ' + $('Evaluar elegibilidad').item.json.carrito_id + ' de ' + $('Evaluar elegibilidad').item.json.cliente + ' (' + $('Evaluar elegibilidad').item.json.importe + ' EUR, ' + $('Evaluar elegibilidad').item.json.horas_abandonado + ' h abandonado).\\nSe enviara la plantilla aprobada \"recordatorio_carrito\" por WhatsApp al ' + $('Evaluar elegibilidad').item.json.telefono + '.\\nAprueba para enviar; ignora para no contactar.' }}",
        "responseType": "approval",
        "options": {}
