      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REEMPLAZAR",
          "name": "Google Sheets (OAuth2)"
        }
      }
    },
    {
      "parameters": {
        "sendTo": "REEMPLAZAR@tuempresa.com",
        "subject": "={{ 'Factura dudosa: ' + $json.archivo }}",
        "emailType": "text",
        "message": "={{ 'La extraccion automatica de la factura \"' + $json.archivo + '\" necesita revision humana.\\n\\nProveedor: ' + $json.proveedor + '\\nTotal detectado: ' + $json.total + '\\nConfianza IA: ' + $json.confianza + '\\n\\nDatos completos en la pestaña \"Facturas dudosas\". No se ha contabilizado nada automaticamente.' }}",
        "options": {}
      },
      "id": "nodo-011",
      "name": "Pedir revisión humana",
