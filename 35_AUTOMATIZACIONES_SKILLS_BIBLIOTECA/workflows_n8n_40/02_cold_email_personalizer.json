{
  "name": "02 · Personalizador de cold email con borradores en Gmail",
  "nodes": [
    {
      "parameters": {
        "content": "## 02 · Cold email personalizado\n\n1. Credenciales: Anthropic API, Gmail (OAuth2) y Google Sheets (OAuth2).\n2. Crea las pestañas \"Borradores enviados a Gmail\" y \"Prospectos incompletos\" en tu hoja.\n3. IMPORTANTE: este flujo SOLO crea BORRADORES en Gmail. Nunca envía nada. Tú revisas cada borrador y decides si lo mandas.",
        "width": 420,
        "height": 240
      },
      "id": "nodo-001",
      "name": "Nota · Configuración",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        40,
        20
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "wf-02-prospecto-nuevo",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "nodo-002",
      "name": "Webhook prospecto",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        40,
        400
      ]
    },
    {
      "parameters": {
        "jsCode": "// Los datos del prospecto llegan dentro de body.\nconst b = $json.body ?? {};\nreturn [{ json: {\n  nombre: String(b.nombre ?? '').trim(),\n  email: String(b.email ?? '').trim().toLowerCase(),\n  empresa: String(b.empresa ?? '').trim(),\n  cargo: String(b.cargo ?? '').trim(),\n  sector: String(b.sector ?? '').trim(),\n  detalle: String(b.detalle ?? '').trim(),\n  recibido_en: new Date().toISOString(),\n} }];"
      },
      "id": "nodo-003",
      "name": "Normalizar prospecto",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        400
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}"
      },
      "id": "nodo-004",
      "name": "Responder recepción",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        480,
        400
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "cond-1",
              "leftValue": "={{ $json.email }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            },
            {
              "id": "cond-2",
              "leftValue": "={{ $json.empresa }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "nodo-005",
      "name": "¿Datos obligatorios?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        700,
        400
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'claude-opus-5', max_tokens: 1024, system: \"Eres un experto en cold email B2B en espanol: cercano, breve, sin promesas exageradas. Responde SOLO con JSON valido con las claves asunto y cuerpo.\", messages: [{ role: 'user', content: 'Escribe un cold email de maximo 120 palabras para este prospecto de una formacion de IA para empresas. Personaliza con su empresa, cargo y sector. Termina con una pregunta suave, no con una venta agresiva. Prospecto: ' + JSON.stringify($json) }] }) }}",
        "options": {}
      },
      "id": "nodo-006",
      "name": "Redactar email con IA",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        920,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REEMPLAZAR",
          "name": "Anthropic API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// La API de Anthropic devuelve una lista de bloques; con el razonamiento\n// activado el primero puede ser de tipo \"thinking\", asi que buscamos el\n// primer bloque de texto en vez de leer content[0] a ciegas.\nconst bloque = ($json.content || []).find((b) => b.type === 'text');\nconst texto = bloque ? bloque.text : '';\nlet ia = {};\ntry {\n  // La IA a veces envuelve el JSON en un bloque de codigo; lo limpiamos.\n  ia = JSON.parse(texto.replace(/^\\s*```(?:json)?/i, '').replace(/```\\s*$/, '').trim());\n} catch (e) {\n  ia = { asunto: 'REVISAR: la IA no devolvio JSON', cuerpo: texto };\n}\nconst original = $('Normalizar prospecto').item.json;\nreturn [{ json: { ...original, ...Object.fromEntries(Object.entries(ia && typeof ia === 'object' && !Array.isArray(ia) ? ia : {}).filter(([key]) => !(key in original))), ia_texto_bruto: texto.slice(0, 500) } }];"
      },
      "id": "nodo-007",
      "name": "Interpretar borrador",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1140,
        300
      ]
    },
    {
      "parameters": {
        "resource": "draft",
        "subject": "={{ $json.asunto }}",
        "emailType": "text",
        "message": "={{ $json.cuerpo + '\\n\\n--\\nBorrador generado automaticamente: revisalo antes de enviarlo.' }}",
        "options": {
          "sendTo": "={{ $json.email }}"
        }
      },
      "id": "nodo-008",
      "name": "Crear borrador en Gmail",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        1360,
        300
      ],
      "credentials": {
        "gmailOAuth2": {
          "id": "REEMPLAZAR",
          "name": "Gmail (OAuth2)"
        }
      }
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "REEMPLAZAR_ID_DOCUMENTO"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Borradores enviados a Gmail"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "fecha": "={{ $json.recibido_en }}",
            "email": "={{ $json.email }}",
            "empresa": "={{ $json.empresa }}",
            "asunto": "={{ $json.asunto }}",
            "estado": "borrador pendiente de revision humana"
          },
          "matchingColumns": [],
          "schema": []
        },
        "options": {}
      },
      "id": "nodo-009",
      "name": "Registrar borrador",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        1580,
        300
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REEMPLAZAR",
          "name": "Google Sheets (OAuth2)"
        }
      }
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "REEMPLAZAR_ID_DOCUMENTO"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Prospectos incompletos"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "fecha": "={{ $json.recibido_en }}",
            "motivo": "faltan campos obligatorios (email o empresa)",
            "datos_recibidos": "={{ JSON.stringify($json) }}"
          },
          "matchingColumns": [],
          "schema": []
        },
        "options": {}
      },
      "id": "nodo-010",
      "name": "Registrar incompleto",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        920,
        520
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REEMPLAZAR",
          "name": "Google Sheets (OAuth2)"
        }
      }
    }
  ],
