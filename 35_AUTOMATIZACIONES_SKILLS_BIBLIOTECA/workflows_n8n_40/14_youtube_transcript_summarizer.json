{
  "name": "14 · Resumen de transcripciones de YouTube",
  "nodes": [
    {
      "parameters": {
        "content": "## 14 · Resumen de transcripciones\n\n1. Credenciales: Anthropic API, Google Sheets y Slack Bot.\n2. Pestañas: \"Resumenes YouTube\" y \"Transcripciones incompletas\".\n3. Envía en el body: video_url, titulo y transcripcion (texto plano; cópiala de YouTube > Mostrar transcripción).\n4. El resumen se comparte en el canal interno de Slack.",
        "width": 440,
        "height": 240
      },
      "id": "nodo-001",
      "name": "Nota · Configuración",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        40,
        20
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "wf-14-transcripcion-youtube",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "nodo-002",
      "name": "Webhook transcripción",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        40,
        400
      ]
    },
    {
      "parameters": {
        "jsCode": "// La transcripcion llega dentro de body; recortamos para controlar coste.\nconst b = $json.body ?? {};\nreturn [{ json: {\n  video_url: String(b.video_url ?? '').trim(),\n  titulo: String(b.titulo ?? 'Video sin titulo').trim(),\n  transcripcion: String(b.transcripcion ?? '').trim().slice(0, 40000),\n  recibido_en: new Date().toISOString(),\n} }];"
      },
      "id": "nodo-003",
      "name": "Normalizar transcripción",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        400
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}"
      },
      "id": "nodo-004",
      "name": "Responder recepción",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        480,
        400
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "cond-1",
              "leftValue": "={{ $json.transcripcion }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "nodo-005",
      "name": "¿Trae transcripción?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        700,
        400
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'claude-opus-5', max_tokens: 2048, system: \"Eres editor de contenido. Responde SOLO con JSON valido con: resumen (5-8 frases), puntos_clave (lista de 5 strings), citas (lista de 2-3 frases textuales) y para_quien (1 frase).\", messages: [{ role: 'user', content: 'Resume esta transcripcion del video \"' + $json.titulo + '\" (' + $json.video_url + '):\\n' + $json.transcripcion }] }) }}",
        "options": {}
      },
      "id": "nodo-006",
      "name": "Resumir con IA",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        920,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REEMPLAZAR",
          "name": "Anthropic API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// La API de Anthropic devuelve una lista de bloques; con el razonamiento\n// activado el primero puede ser de tipo \"thinking\", asi que buscamos el\n// primer bloque de texto en vez de leer content[0] a ciegas.\nconst bloque = ($json.content || []).find((b) => b.type === 'text');\nconst texto = bloque ? bloque.text : '';\nlet ia = {};\ntry {\n  // La IA a veces envuelve el JSON en un bloque de codigo; lo limpiamos.\n  ia = JSON.parse(texto.replace(/^\\s*```(?:json)?/i, '').replace(/```\\s*$/, '').trim());\n} catch (e) {\n  ia = { resumen: texto.slice(0, 2000), puntos_clave: [], citas: [], para_quien: '' };\n}\nconst original = $('Normalizar transcripción').item.json;\nreturn [{ json: { ...original, ...ia, ia_texto_bruto: texto.slice(0, 500) } }];"
      },
      "id": "nodo-007",
      "name": "Interpretar resumen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1140,
        300
      ]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "REEMPLAZAR_ID_DOCUMENTO"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Resumenes YouTube"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "fecha": "={{ $json.recibido_en }}",
            "titulo": "={{ $json.titulo }}",
            "video_url": "={{ $json.video_url }}",
            "resumen": "={{ $json.resumen }}",
            "puntos_clave": "={{ ($json.puntos_clave || []).join(\" | \") }}",
            "para_quien": "={{ $json.para_quien }}"
          },
          "matchingColumns": [],
          "schema": []
        },
        "options": {}
      },
      "id": "nodo-008",
      "name": "Registrar resumen",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        1360,
        300
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REEMPLAZAR",
          "name": "Google Sheets (OAuth2)"
        }
      }
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "id",
          "value": "REEMPLAZAR_ID_CANAL"
        },
        "text": "={{ 'RESUMEN DE VIDEO: ' + $json.titulo + '\\n' + $json.video_url + '\\n\\n' + $json.resumen + '\\n\\nPuntos clave:\\n' + ($json.puntos_clave || []).map((p) => '- ' + p).join('\\n') }}",
        "otherOptions": {}
      },
      "id": "nodo-009",
      "name": "Compartir resumen",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [
        1580,
        300
      ],
      "credentials": {
        "slackApi": {
          "id": "REEMPLAZAR",
          "name": "Slack Bot"
        }
      }
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "REEMPLAZAR_ID_DOCUMENTO"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Transcripciones incompletas"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "fecha": "={{ $json.recibido_en }}",
            "video_url": "={{ $json.video_url }}",
            "motivo": "la peticion no traia el campo transcripcion"
          },
          "matchingColumns": [],
          "schema": []
        },
        "options": {}
      },
      "id": "nodo-010",
      "name": "Registrar incompleta",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        920,
        520
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REEMPLAZAR",
          "name": "Google Sheets (OAuth2)"
        }
      }
    }
  ],
  "connections": {
